# ============================================
# Hallet EdTech Platform — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/hallet?schema=public"

# NextAuth
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Hallet"

# Encryption (for study materials)
# ENCRYPTION_KMS_KEY_ID=""
# ENCRYPTION_ALGORITHM="aes-256-gcm"







